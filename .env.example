# Copy to .env and fill as needed. Public values only, never secrets.
# All values are optional: empty ones fall back to src/config/contracts.js.

# Reown (WalletConnect) project id from https://dashboard.reown.com
# Public by design. Without it the app only supports browser extension wallets.
VITE_WALLETCONNECT_PROJECT_ID=

# mainnet | testnet
VITE_KNIX_NETWORK=mainnet

# Optional RPC / explorer overrides
VITE_RPC_URL_MAINNET=
VITE_BLOCK_EXPLORER_URL_MAINNET=
VITE_RPC_URL_TESTNET=
VITE_BLOCK_EXPLORER_URL_TESTNET=

# Contracts. Mainnet values are already set in src/config/contracts.js; these override them.
VITE_KNIX_CORE_ADDRESS=
VITE_KNIX_LENS_ADDRESS=
# $KNIX token. Empty keeps the contract address section on Coming Soon.
VITE_KNIX_TOKEN_ADDRESS=
