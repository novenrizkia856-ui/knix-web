# Copy to .env and fill as contracts deploy. Public values only, never secrets.
# All values are optional. Empty values fall back to src/config/contracts.js.

# mainnet | testnet
VITE_KNIX_NETWORK=mainnet

# Optional RPC / explorer overrides
VITE_RPC_URL_MAINNET=
VITE_BLOCK_EXPLORER_URL_MAINNET=
VITE_RPC_URL_TESTNET=
VITE_BLOCK_EXPLORER_URL_TESTNET=

# Contracts
VITE_KNIX_TOKEN_ADDRESS=
VITE_POOL_ADDRESS=
VITE_POOL_ASSET_A_ADDRESS=
VITE_POOL_ASSET_B_ADDRESS=
VITE_POOL_ASSET_A_SYMBOL=
VITE_POOL_ASSET_B_SYMBOL=
VITE_ROUTER_ADDRESS=
VITE_VAULT_ADDRESS=
VITE_STAKING_ADDRESS=
VITE_GOVERNOR_ADDRESS=
