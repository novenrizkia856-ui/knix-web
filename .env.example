# Copy to .env and fill as needed. Public values only, never secrets.
# All values are optional: empty ones fall back to src/config/solana.js.

# Reown (WalletConnect) project id from https://dashboard.reown.com
# Public by design. Without it the app only supports injected Solana wallets.
VITE_WALLETCONNECT_PROJECT_ID=

# mainnet-beta | devnet
VITE_SOLANA_NETWORK=mainnet-beta

# Optional RPC / explorer overrides. The public RPC is rate limited; use a managed one in production.
VITE_SOLANA_RPC_URL=
VITE_SOLANA_EXPLORER_URL=

# Knix accounts. Leave empty until the real addresses exist; empty shows Pending / Coming Soon.
# Knix program id. No program is deployed yet, execution stays disabled either way.
VITE_KNIX_PROGRAM_ID=
# $KNIX SPL token mint. Empty keeps the CA section on Coming Soon.
VITE_KNIX_TOKEN_MINT=
VITE_KNIX_TREASURY_ADDRESS=
